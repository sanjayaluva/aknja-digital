# ==============================================================================
# Aknja Digital — environment template
# Copy to .env, fill what you use, generate a unique SECRET_KEY.
# NEVER commit real secrets (docs/23, docs/28). The platform is designed to
# START AND RUN with every provider below disabled (SRS §14 baseline).
# ==============================================================================

APP_ENV=local
APP_NAME=Aknja Digital
SECRET_KEY=replace-with-random-secret
DATABASE_URL=postgresql+psycopg://aknja:aknja_local_only@localhost:5432/aknja
LOG_LEVEL=INFO

# --- Protected zero-cost governance (v5.3.1) — cannot be weakened at runtime.
ZERO_COST_MODE=true
MAX_APPROVED_MONTHLY_SPEND_MINOR=0
PAID_FALLBACK_ENABLED=false
AUTO_UPGRADE_ENABLED=false
AUTO_TOPUP_ENABLED=false
HARD_STOP_THRESHOLD_PCT=95.0

# --- Sessions / storage
SESSION_TTL_HOURS=168
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=var/storage

# ==============================================================================
# PROVIDER CANDIDATES (v5.3.2 category pools + SRS §9 env spec)
# ------------------------------------------------------------------------------
# RULES (docs/33, v5.3.1): every provider below is a CANDIDATE, not an
# entitlement. Keys alone enable nothing: the account must be verified in the
# provider registry (`python -m app.cli verify-provider ...`) with recorded
# evidence (plan, quota, reset, privacy, commercial-use terms) before the
# quota engine will admit ANY usage. Unverified/stale/unknown = fail closed.
# Documented free-tier numbers live in docs/source_provider_pools_v5.3.2.md
# with source URLs; they change — always re-check the provider console.
# ==============================================================================

# --- Category: RELATIONAL_DATABASE (pool: Neon / Supabase / OCI-hosted PG)
# DATABASE_URL above points at the ACTIVE primary. Pool candidates stay
# registered in the provider registry only.
# Neon Free — https://neon.com/docs/introduction/free-plan
# Supabase Free — https://supabase.com/pricing

# --- Category: OBJECT_STORAGE (pool: Cloudflare R2 / Tigris / Backblaze B2 / OCI)
# Primary adapter settings (S3-compatible):
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Cloudflare R2 specifics (SRS §9; bucket default: aknja-digital-artifacts)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aknja-digital-artifacts
# Alternate pool members (S3-compatible) — verify plans before use:
TIGRIS_ACCESS_KEY_ID=
TIGRIS_SECRET_ACCESS_KEY=
TIGRIS_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=

# --- Category: AI_LLM — Layer 1 free pool (SRS §8.4, v5.3.2 §5C)
# Master switch: adapters stay off until registry verification passes.
AI_PROVIDER_ENABLED=false
GEMINI_API_KEYS=            # comma-separated keys; free tier trains on content — never send confidential client data
GROQ_API_KEYS=              # comma-separated keys; free developer access, current model/rate limits apply
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=         # use only `:free` model slugs
MISTRAL_API_KEY=
HF_TOKEN=                   # Hugging Face (serverless inference / Spaces)

# --- Category: TRANSACTIONAL_EMAIL (pool: Brevo / Resend / MailerSend)
BREVO_API_KEY=              # free: 300 sends/day (docs/source_provider_pools_v5.3.2.md)
RESEND_API_KEY=             # free: 3,000/month, 100/day, 3 domains
MAILERSEND_API_KEY=         # free: 500/month after account approval

# --- Category: CACHE_QUEUE (pool: Upstash Redis Free / self-hosted / DB queue)
REDIS_URL=                  # e.g. rediss://default:token@xxx.upstash.io:6379

# --- Category: SPEECH (pool: Azure Speech F0 / Sarvam / Gemini audio)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
SARVAM_API_KEY=             # Indic-language (ml/hi/ta) candidate — verify plan/privacy

# --- Telegram HITL control plane (optional; approvals stay in-portal while unset)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Optional compute offload & integrations (SRS §9)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
KAGGLE_USERNAME=
KAGGLE_KEY=                 # interactive/best-effort GPU notebooks only — not durable compute
JINA_API_KEY=
WAHA_API_URL=               # WhatsApp Business bridge (daily warm-up limit applies)
WAHA_API_KEY=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_SECRET_REF=
