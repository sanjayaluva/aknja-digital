[Unit]
Description=Aknja free-provider quota snapshot refresh (llm-ping x4)
Documentation=file:///home/ubuntu/aknja-digital/docs/33_FREE_TIER_AND_PROVIDER_VERIFICATION_REGISTER.md

[Service]
Type=oneshot
User=ubuntu
